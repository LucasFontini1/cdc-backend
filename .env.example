# Copie para .env. Nunca publique credenciais reais.
# Gerar chave: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=development-only-replace-this-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
SECURE_SSL_REDIRECT=False
DATABASE_URL=sqlite:///db.sqlite3
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173
# cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_URL=
